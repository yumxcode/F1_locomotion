{
  "entry": "init_state",
  "nodes": [
    {
      "id": "init_state",
      "kind": "executor",
      "taskDescription": "状态目录在项目根 state/ 与 logs/。若 state/task_spec.md 缺失：依 .oma/requirements.md 与 .oma/designs/design-unified-reward.md（AgiBot X1 人形行走 RL）生成 task_spec.md（目标/里程碑/成功标准，max_iterations=10，success_threshold），并初始化 progress.json(iteration0,status:healthy,stale_count0,total_findings0,best_metric:null,updated_at)、findings.jsonl、directions_tried.json({directions:[]})、iteration_log.jsonl、logs/work.jsonl、logs/orchestrator.jsonl；已存在勿改。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash"
      ],
      "maxTurns": 30,
      "maxBudgetUsd": 0.4,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "load_state",
      "kind": "executor",
      "taskDescription": "只读 state/task_spec.md、progress.json、directions_tried.json、findings.jsonl 末若干条，汇总当前 iteration/status/stale_count/已试方向/最佳指标作为本轮起点摘要。勿写。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash"
      ],
      "maxTurns": 20,
      "maxBudgetUsd": 0.2,
      "workspaceMode": "shared_readonly"
    },
    {
      "id": "explore",
      "kind": "parallel",
      "taskDescription": "并行多角度只读探索喂给方向选择：investigation(未试机制)、refutation(挑战主线假设)、cross_domain(跨领域类比)。各读 .oma 设计/findings/论文，分别写各自 md 文件。join=all。",
      "branches": [
        {
          "id": "investigation",
          "taskDescription": "调研尚未出现在 directions_tried 的步态/控制机制及最新论文思路（可用 paper_search），列候选方向+依据，写 logs/exploration_investigation.md。仅读源码/.oma，写域限该文件。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "edit_file",
            "bash",
            "paper_search"
          ],
          "maxTurns": 25,
          "maxBudgetUsd": 0.4,
          "workspaceMode": "isolated_write",
          "writeScope": [
            "logs/exploration_investigation.md"
          ]
        },
        {
          "id": "refutation",
          "taskDescription": "找出并论证当前主线(.oma/designs/design-unified-reward.md)最可能被推翻的假设，写 logs/exploration_refutation.md。仅读，写域限该文件。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "edit_file",
            "bash",
            "paper_search"
          ],
          "maxTurns": 25,
          "maxBudgetUsd": 0.4,
          "workspaceMode": "isolated_write",
          "writeScope": [
            "logs/exploration_refutation.md"
          ]
        },
        {
          "id": "cross_domain",
          "taskDescription": "寻找跨领域(其他 humanoid/外骨骼/双足动物)结构相似案例与可迁移机制，写 logs/exploration_analogy.md。仅读，写域限该文件。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "edit_file",
            "bash",
            "paper_search"
          ],
          "maxTurns": 25,
          "maxBudgetUsd": 0.4,
          "workspaceMode": "isolated_write",
          "writeScope": [
            "logs/exploration_analogy.md"
          ]
        }
      ],
      "join": "all"
    },
    {
      "id": "choose_direction",
      "kind": "executor",
      "taskDescription": "依据 state/directions_tried.json、findings.jsonl 与 logs/exploration_*.md(若存在)，选一个与历史不同且可证伪的方向，优先结构性差异而非仅调参；写 state/current_direction.json(iteration,direction,category,tags,rationale,hypothesis,structural,proposed_changes)。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash"
      ],
      "maxTurns": 25,
      "maxBudgetUsd": 0.3,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "diversity_check",
      "kind": "code",
      "taskDescription": "校验所选方向与历史是否足够不同，返回 diverse/not_diverse。",
      "codeSpec": {
        "description": "读 state/current_direction.json 与 state/directions_tried.json，按 category/tags 计算与历史方向重叠度；与任一已试方向高度重叠→not_diverse，否则 diverse；写 state/.diversity_verdict.json。",
        "inputs": [
          "state/current_direction.json",
          "state/directions_tried.json"
        ],
        "outputs": [
          "state/.diversity_verdict.json"
        ],
        "labels": [
          "diverse",
          "not_diverse"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/c2f782e62d04e10d4af2a9621c94b3be748b8d9fed1d3cae631b1d3c0a163fe4.mjs",
      "sourceHash": "c2f782e62d04e10d4af2a9621c94b3be748b8d9fed1d3cae631b1d3c0a163fe4"
    },
    {
      "id": "research_train",
      "kind": "executor",
      "taskDescription": "按 state/current_direction.json 推进：先 paper_search 查方法、grep/read humanoid/ 代码并算数(reward scale/curriculum)后再实现并 git 提交；严格按 .oma/skills/gradmotion/SKILL.md 模板(goodsId/imageVersion/taskBaseInfo 两层)dry-run 后 gm task create+run。每~30min 用 auto_orch_pause_external 等待，恢复后 gm task info/data 判断，平台期或明显变差则 stop 并收指标；余额不足用 account-pool remove<当前id> 再 account-pool get 换号。写 state/raw_iteration_result.json(指标/gmTaskId/commit/观察)。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash",
        "paper_search"
      ],
      "maxTurns": 150,
      "maxBudgetUsd": 6,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "extract_findings",
      "kind": "executor",
      "taskDescription": "读 state/raw_iteration_result.json 与训练日志，把本轮整理为结构化 findings(每条 claim+证据+指标)，警惕 reward hacking（高奖励但无物理可信度视为无效）；写 state/iteration_findings.json(iteration,gm_task_id,commit_hash,direction,metrics,findings[]，raw_result_path)。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash"
      ],
      "maxTurns": 40,
      "maxBudgetUsd": 0.4,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "verify_findings",
      "kind": "role",
      "taskDescription": "审查 state/iteration_findings.json：每条 finding 是否有具体证据(指标/时刻/观察)、是否与 findings.jsonl 重复、是否与训练结果一致。pass=合格，fail=列出缺失项。",
      "role": "reviewer",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash"
      ]
    },
    {
      "id": "semantic_eval",
      "kind": "executor",
      "taskDescription": "对比本轮指标与 progress.json.best_metric，判断 findings 是否真正新增(is_novel)及结果是否优化(metric_delta)，并依 task_spec 阈值判 success_met；写 state/iteration_eval.json(iteration,new_findings_count,metric_value,metric_delta,success_met,is_novel,duplicates[],rationale)。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash"
      ],
      "maxTurns": 30,
      "maxBudgetUsd": 0.3,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "reduce_progress",
      "kind": "code",
      "taskDescription": "据 semantic_eval 确定性更新 progress.json 的 stale_count/status。",
      "codeSpec": {
        "description": "读 state/iteration_eval.json 与 state/progress.json。success_met=true→status=complete；否则 new_findings_count<=0 或 metric_delta<0→stale_count+1，否则 stale_count=max(0,stale_count-1)。total_findings+=new_findings_count；iteration+1；iteration>=max_iterations→status=attention_required；否则按 stale_count 设 status(>=4 attention_required,>=2 pivot_required,==1 stale,==0 healthy)。更新 best_metric 与 updated_at。写 progress.json。",
        "inputs": [
          "state/iteration_eval.json",
          "state/progress.json"
        ],
        "outputs": [
          "state/progress.json"
        ],
        "labels": [
          "healthy",
          "stale",
          "pivot_required",
          "attention_required",
          "complete"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/2c5a7dce06447ce8030b8c9319ff4466df0c260d3faad1b976fa3ccf96448c7b.mjs",
      "sourceHash": "2c5a7dce06447ce8030b8c9319ff4466df0c260d3faad1b976fa3ccf96448c7b"
    },
    {
      "id": "state_writer",
      "kind": "code",
      "taskDescription": "集中 append findings/方向/日志并原子更新 progress.json。",
      "codeSpec": {
        "description": "读 state/iteration_findings.json、current_direction.json、iteration_eval.json、progress.json、(可选)pivot_directive.json。逐条 append 新 findings 到 findings.jsonl；把本轮方向(含 iteration/tags/status/pivot)并入 directions_tried.json；向 iteration_log.jsonl append 本轮摘要(iteration/direction/eval/status/ts)；原子更新 progress.json(updated_at)；向 logs/work.jsonl append。集中写，勿并发。",
        "inputs": [
          "state/iteration_findings.json",
          "state/current_direction.json",
          "state/iteration_eval.json",
          "state/progress.json",
          "state/pivot_directive.json"
        ],
        "outputs": [
          "state/findings.jsonl",
          "state/directions_tried.json",
          "state/iteration_log.jsonl",
          "state/progress.json",
          "logs/work.jsonl"
        ],
        "labels": [
          "ok",
          "error"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write",
        "jsonl.append"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/a354420728d450e3982a488bc3ccd3e3cbf9a133e987ee3a7f0395ef725a8e7e.mjs",
      "sourceHash": "a354420728d450e3982a488bc3ccd3e3cbf9a133e987ee3a7f0395ef725a8e7e"
    },
    {
      "id": "verify_state",
      "kind": "role",
      "taskDescription": "审查 state 写入：findings.jsonl 新增行数==iteration_eval.new_findings_count、directions_tried 含本轮条目、iteration_log.jsonl 含本轮摘要、progress.json 的 stale_count/status 与 iteration_eval 一致。pass=放行，fail=列不符项。",
      "role": "reviewer",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash"
      ]
    },
    {
      "id": "route",
      "kind": "code",
      "taskDescription": "据 progress.status 路由下一步。",
      "codeSpec": {
        "description": "读 state/progress.json 的 status，返回同名 label(healthy/stale/pivot_required/attention_required/complete)，写 state/.route.json。",
        "inputs": [
          "state/progress.json"
        ],
        "outputs": [
          "state/.route.json"
        ],
        "labels": [
          "healthy",
          "stale",
          "pivot_required",
          "attention_required",
          "complete"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/76df3a875c8e327da43a0e52557e29ede8b9aac4c91aedba199be3fa541f6ee4.mjs",
      "sourceHash": "76df3a875c8e327da43a0e52557e29ede8b9aac4c91aedba199be3fa541f6ee4"
    },
    {
      "id": "pivot",
      "kind": "executor",
      "taskDescription": "stale_count>=2 触发的结构性转向：不要只调参，改变结构性约束或研究框架——从相反假设出发、换证据类型、找跨领域相似案例、改评估指标/环境假设。读 state 全貌与 design doc，写 state/pivot_directive.json(新框架/反假设/跨领域类比/新约束/建议方向)供下轮 choose_direction 采用。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "edit_file",
        "bash",
        "paper_search"
      ],
      "maxTurns": 40,
      "maxBudgetUsd": 0.5,
      "workspaceMode": "isolated_write"
    },
    {
      "id": "attention_report",
      "kind": "code",
      "taskDescription": "停滞/预算耗尽时写报告并停止（终态）。",
      "codeSpec": {
        "description": "读 state/progress.json、iteration_log.jsonl、findings.jsonl、directions_tried.json，撰写 state/attention_required.md：停滞原因(stale_count>=4 或预算耗尽)、已试方向、最近指标、推荐的下一步结构性调整。",
        "inputs": [
          "state/progress.json",
          "state/iteration_log.jsonl",
          "state/findings.jsonl",
          "state/directions_tried.json"
        ],
        "outputs": [
          "state/attention_required.md"
        ],
        "labels": [
          "ok"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/12f7e8392845c0d7fd1c9db5da164929d16260cf194a9f59a7f6fa69af8c66b3.mjs",
      "sourceHash": "12f7e8392845c0d7fd1c9db5da164929d16260cf194a9f59a7f6fa69af8c66b3"
    },
    {
      "id": "error_writer",
      "kind": "code",
      "taskDescription": "写错误状态与 iteration_log 后停止（终态）。",
      "codeSpec": {
        "description": "读 state/progress.json 与最近 state，向 state/iteration_log.jsonl append 错误条目(errorClass/summary/ts)并写 state/error_state.json。",
        "inputs": [
          "state/progress.json"
        ],
        "outputs": [
          "state/iteration_log.jsonl",
          "state/error_state.json"
        ],
        "labels": [
          "ok"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write",
        "jsonl.append"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      },
      "codeRef": "code_nodes/347c77d3deb20868c19c86fa5d28c4502aa045281c14f3077685eff3aaeba221.mjs",
      "sourceHash": "347c77d3deb20868c19c86fa5d28c4502aa045281c14f3077685eff3aaeba221"
    }
  ],
