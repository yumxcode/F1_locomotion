{
  "entry": "load_state",
  "nodes": [
    {
      "id": "load_state",
      "kind": "executor",
      "taskDescription": "读取 state/task_spec.md、progress.json、directions_tried.json、findings.jsonl 末尾若干条，汇总当前 iteration/status/已试方向/最近发现，写入 state/iteration_context.json 供下游参考。只读+汇总，不改动其他 state。返回 ok；state 损坏返回 error。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "choose_direction",
      "kind": "executor",
      "taskDescription": "读 state/iteration_context.json、directions_tried.json、(若存在)state/pivot_plan.json。选一个与历史 directions 均不同的新研究方向以推进 task_spec 当前里程碑，写入 state/chosen_direction.json（含 id/description/hypothesis/expected_metric）。返回 ok。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "explore_directions",
      "kind": "parallel",
      "taskDescription": "对 state/chosen_direction.json 的研究假设做多角度只读验证（正面/反面/跨域），由 integrator 综合三路结论供 research_design_train 参考。join=quorum(2)，分支 shared_readonly 不写文件。",
      "branches": [
        {
          "id": "investigation",
          "taskDescription": "正面验证 state/chosen_direction.json 假设：读 .oma/designs/、humanoid/ 代码与 state/findings.jsonl，找支持证据与可落地实现路径。只读，输出证据摘要。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "bash"
          ],
          "workspaceMode": "shared_readonly"
        },
        {
          "id": "refutation",
          "taskDescription": "反面质疑该假设：找可能失败原因（梯度冲突/reward hacking/sim-to-real gap），参考 .oma/memory.md 的 Dead Ends。只读，输出风险清单。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "bash"
          ],
          "workspaceMode": "shared_readonly"
        },
        {
          "id": "cross_domain_analogy",
          "taskDescription": "找跨领域结构相似案例（双足/四足涌现步态研究）佐证或修正方向，可用 paper_search。只读，输出类比与启示。",
          "allowedTools": [
            "read_file",
            "grep",
            "glob",
            "bash"
          ],
          "workspaceMode": "shared_readonly"
        }
      ],
      "join": "quorum",
      "quorum": 2,
      "integrator": "exploration_integrator"
    },
    {
      "id": "research_design_train",
      "kind": "executor",
      "taskDescription": "围绕 state/chosen_direction.json（含上游 explore_directions 综合）做本轮研究：先 paper_search + 读 humanoid/、.oma/designs/ 代码算数确认数值，再改 reward/config 并 git push。按 .oma/skills/train 与 gradmotion SKILL.md 用 gm 启动远端训练（配置 .oma/config.json；无余额则 account-pool remove 当前id 后 get），启动后 auto_orch_pause_external 暂停等待。恢复后查 logs，平台期即 stop，收 metrics 写 state/training_result.json 返回 ok；不可恢复失败返回 error。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file",
        "auto_orch_pause_external"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "extract_findings",
      "kind": "executor",
      "taskDescription": "读 state/training_result.json 与 state/findings.jsonl，把本轮训练/研究结果整理为结构化 findings（每条含 category/description/evidence/impact/verifiable），写入 state/iteration_extract.json。返回 ok。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "semantic_eval",
      "kind": "executor",
      "taskDescription": "读 state/iteration_extract.json 与全部 state/findings.jsonl，判断本轮 findings 是否真正新增（非重复）及指标是否优化。输出 state/iteration_eval.json：new_findings_count、metric_delta、metric_value、findings_to_append[]、direction_entry{}、iteration_log_entry{}、is_optimized。返回 ok。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "verify_findings",
      "kind": "role",
      "taskDescription": "审查 state/iteration_eval.json 的 findings_to_append：每条是否有具体 evidence、是否与 state/findings.jsonl 已有条目实质重复。全部合格→pass；否则→fail 并列出不合格项与纠偏建议（投递回 extract_findings）。",
      "role": "verify",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash"
      ],
      "workspaceMode": "shared_readonly"
    },
    {
      "id": "reduce_progress",
      "kind": "code",
      "taskDescription": "据 semantic_eval 结果确定性更新 progress.json 的 stale_count/status/iteration。",
      "codeSpec": {
        "description": "读 state/progress.json 与 state/iteration_eval.json。若 new_findings_count<=0 或 metric_delta<0 → stale_count+=1，否则 stale_count=max(0,stale_count-1)。iteration+=1。status：>=4→attention_required，>=2→pivot_required，==0→healthy，其余→stale。若 status==healthy 则 healthy_streak+=1 否则 healthy_streak=0。更新 last_direction(取 iteration_eval.direction_entry.id)、last_metric(metric_value)、total_findings(+=new_findings_count)、updated_at(UTC ISO)。temp+rename 原子写 state/progress.json。成功返回 updated，异常返回 error。",
        "inputs": [
          "state/progress.json",
          "state/iteration_eval.json"
        ],
        "outputs": [
          "state/progress.json"
        ],
        "labels": [
          "updated",
          "error"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      }
    },
    {
      "id": "state_writer",
      "kind": "code",
      "taskDescription": "集中、原子地落盘本轮 findings/direction/iteration_log，并消费 pivot 暂存。",
      "codeSpec": {
        "description": "读 state/iteration_eval.json 与 state/progress.json。append iteration_eval.findings_to_append 每条到 state/findings.jsonl；append iteration_eval.direction_entry 到 state/directions_tried.json 的 directions 数组并刷新 last_updated；append iteration_eval.iteration_log_entry 到 state/iteration_log.jsonl。若 state/pivot_plan.json 存在：将其摘要 append 到 state/directions_tried.json 的 pivots 数组，并清空(置空对象) pivot_plan.json。校验 progress.total_findings 等于 findings.jsonl 行数后，temp+rename 原子重写 state/progress.json。全部成功返回 written，任一失败返回 error。",
        "inputs": [
          "state/iteration_eval.json",
          "state/progress.json",
          "state/findings.jsonl",
          "state/directions_tried.json",
          "state/iteration_log.jsonl",
          "state/pivot_plan.json"
        ],
        "outputs": [
          "state/findings.jsonl",
          "state/directions_tried.json",
          "state/iteration_log.jsonl",
          "state/progress.json",
          "state/pivot_plan.json"
        ],
        "labels": [
          "written",
          "error"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write",
        "jsonl.append"
      ],
      "codeBounds": {
        "timeoutMs": 5000,
        "maxOutputBytes": 65536
      }
    },
    {
      "id": "verify_state_update",
      "kind": "role",
      "taskDescription": "审查 state 文件是否按协议更新：progress.json 含 iteration/status/stale_count/total_findings/updated_at；findings.jsonl 已追加新条目；directions_tried.json 已更新；iteration_log.jsonl 已追加。合规→pass；否则→fail 列出缺失项（投递回 state_writer）。",
      "role": "verify",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash"
      ],
      "workspaceMode": "shared_readonly"
    },
    {
      "id": "route_by_status",
      "kind": "code",
      "taskDescription": "据 progress.status 确定性路由，并判定完成。",
      "codeSpec": {
        "description": "读 state/progress.json。若 (healthy_streak>=10 且 total_findings>=20) 或 iteration>=20 → 返回 done。否则按 status 字段返回同名 label：healthy/stale/pivot_required/attention_required；status 缺失或未知 → attention_required。",
        "inputs": [
          "state/progress.json"
        ],
        "outputs": [],
        "labels": [
          "done",
          "healthy",
          "stale",
          "pivot_required",
          "attention_required"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read"
      ],
      "codeBounds": {
        "timeoutMs": 2000,
        "maxOutputBytes": 4096
      }
    },
    {
      "id": "structural_pivot",
      "kind": "executor",
      "taskDescription": "stale_count>=2，禁止只调参。改变结构性约束/研究框架（相反假设/换证据类型/跨域类比/改评估指标或环境假设），写入 state/pivot_plan.json（新方向+结构性变化+理由）。该文件将由下一轮 state_writer 记入 directions_tried.pivots。返回 ok。",
      "allowedTools": [
        "read_file",
        "grep",
        "glob",
        "bash",
        "edit_file"
      ],
      "workspaceMode": "isolated_write"
    },
    {
      "id": "attention_report_writer",
      "kind": "code",
      "taskDescription": "stale_count>=4，生成人工干预报告后停止。",
      "codeSpec": {
        "description": "读 state/progress.json、state/findings.jsonl、state/directions_tried.json。生成 state/attention_required_report.md：说明 stale_count 达 4，列出最近方向与发现停滞原因、已试 pivot，给出人工干预建议（数据/算力/方向/环境）。返回 ok。",
        "inputs": [
          "state/progress.json",
          "state/findings.jsonl",
          "state/directions_tried.json"
        ],
        "outputs": [
          "state/attention_required_report.md"
        ],
        "labels": [
          "ok"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      }
    },
    {
      "id": "error_writer",
      "kind": "code",
      "taskDescription": "不可恢复错误：置 error 状态并记录后停止。",
      "codeSpec": {
        "description": "读 state/progress.json，将 status 置 'error'、updated_at 刷新为 UTC ISO，temp+rename 原子写回；append 一条到 state/iteration_log.jsonl：{timestamp,iteration,event:'error',summary:'orchestration node error'}。返回 ok。",
        "inputs": [
          "state/progress.json",
          "state/iteration_log.jsonl"
        ],
        "outputs": [
          "state/progress.json",
          "state/iteration_log.jsonl"
        ],
        "labels": [
          "ok"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write",
        "jsonl.append"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 32768
      }
    },
    {
      "id": "completion_report",
      "kind": "code",
      "taskDescription": "研究达成退出条件，生成完成报告后停止。",
      "codeSpec": {
        "description": "读 state/progress.json、state/findings.jsonl、state/directions_tried.json。生成 state/completion_report.md：总结完成轮数、total_findings、关键发现、各里程碑达成情况、后续建议。返回 ok。",
        "inputs": [
          "state/progress.json",
          "state/findings.jsonl",
          "state/directions_tried.json"
        ],
        "outputs": [
          "state/completion_report.md"
        ],
        "labels": [
          "ok"
        ]
      },
      "input": {
        "taskDir": "."
      },
      "capabilities": [
        "state.read",
        "state.write"
      ],
      "codeBounds": {
        "timeoutMs": 3000,
        "maxOutputBytes": 65536
      }
    }
  ],
  "edges": [
    {
      "from": "load_state",
      "to": "choose_direction",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    },
    {
      "from": "load_state",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "choose_direction",
      "to": "explore_directions",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    },
    {
      "from": "choose_direction",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "explore_directions",
      "to": "research_design_train",
      "when": {
        "on": "always"
      }
    },
    {
      "from": "research_design_train",
      "to": "extract_findings",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    },
    {
      "from": "research_design_train",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "extract_findings",
      "to": "semantic_eval",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    },
    {
      "from": "extract_findings",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "semantic_eval",
      "to": "verify_findings",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    },
    {
      "from": "semantic_eval",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "verify_findings",
      "to": "reduce_progress",
      "when": {
        "on": "verdictLabel",
        "label": "pass"
      }
    },
    {
      "from": "verify_findings",
      "to": "extract_findings",
      "when": {
        "on": "verdictLabel",
        "label": "fail"
      }
    },
    {
      "from": "reduce_progress",
      "to": "state_writer",
      "when": {
        "on": "verdictLabel",
        "label": "updated"
      }
    },
    {
      "from": "reduce_progress",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "state_writer",
      "to": "verify_state_update",
      "when": {
        "on": "verdictLabel",
        "label": "written"
      }
    },
    {
      "from": "state_writer",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "verify_state_update",
      "to": "route_by_status",
      "when": {
        "on": "verdictLabel",
        "label": "pass"
      }
    },
    {
      "from": "verify_state_update",
      "to": "state_writer",
      "when": {
        "on": "verdictLabel",
        "label": "fail"
      }
    },
    {
      "from": "route_by_status",
      "to": "load_state",
      "when": {
        "on": "verdictLabel",
        "label": "healthy"
      }
    },
    {
      "from": "route_by_status",
      "to": "load_state",
      "when": {
        "on": "verdictLabel",
        "label": "stale"
      }
    },
    {
      "from": "route_by_status",
      "to": "structural_pivot",
      "when": {
        "on": "verdictLabel",
        "label": "pivot_required"
      }
    },
    {
      "from": "route_by_status",
      "to": "attention_report_writer",
      "when": {
        "on": "verdictLabel",
        "label": "attention_required"
      }
    },
    {
      "from": "route_by_status",
      "to": "completion_report",
      "when": {
        "on": "verdictLabel",
        "label": "done"
      }
    },
    {
      "from": "route_by_status",
      "to": "error_writer",
      "when": {
        "on": "verdictLabel",
        "label": "error"
      }
    },
    {
      "from": "structural_pivot",
      "to": "load_state",
      "when": {
        "on": "verdictLabel",
        "label": "ok"
      }
    }
  ],
  "id": "humanoid-walk-research-loop",
  "bounds": {
    "maxNodeVisits": 30,
    "maxTotalSteps": 500,
    "maxTotalCostUsd": 40,
    "maxWallClockMs": 86400000
  }
}